{
  "name": "northstar-slack-semantic-search",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Semantic search over a fictional AI SaaS Slack workspace",
  "engines": { "node": ">=24" },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "seed": "node --env-file-if-exists=.env scripts/seed.js",
    "verify": "node --env-file-if-exists=.env scripts/verify.js",
    "test": "node --test",
    "test:postman": "node scripts/run-postman.js"
  },
  "dependencies": { "express": "5.2.1", "mongodb": "7.7.0" },
  "devDependencies": { "newman": "6.2.2" }
}
